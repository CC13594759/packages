#!/bin/sh /etc/rc.common
# turn: TURN-over-TCP client (HTTP CONNECT + SOCKS5 proxy, API managed via LuCI)

USE_PROCD=1
START=99
STOP=10

PROG=/usr/bin/node
APP=/usr/share/turn/turn.mjs

start_service() {
	procd_open_instance turn
	procd_set_param command "$PROG" "--max-old-space-size=64" "$APP"
	procd_set_param env \
		"LISTEN_HOST=0.0.0.0" \
		"LISTEN_PORT=8899" \
		"SOCKS_HOST=0.0.0.0" \
		"SOCKS_PORT=9988" \
		"PANEL_HOST=0.0.0.0" \
		"PANEL_PORT=8081"
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
